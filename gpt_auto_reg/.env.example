# ─────────────────────────────────────────────────────────────
# .env.example - Sao chép thành .env rồi điền thông tin thật
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env  (Windows)
# ─────────────────────────────────────────────────────────────

# KaiMail API Keys (lấy từ trang admin kaishop.id.vn)
KAIMAIL_API_KEY=your_api_key_here
KAIMAIL_SECRET_KEY=your_secret_key_here
KAIMAIL_BASE_URL=https://tmail.kaishop.id.vn
KAIMAIL_DOMAIN=kaishop.id.vn
KAIMAIL_NAME_TYPE=en

# Mật khẩu tạo tài khoản ChatGPT
DEFAULT_PASSWORD=kaishop@12345

# Thời gian (giây)
WAIT_TIME=20
MAX_RETRY=3
CHECK_EMAIL_INTERVAL=5
EMAIL_TIMEOUT=300
